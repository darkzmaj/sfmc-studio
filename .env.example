# SFM Character Studio has no server-side secrets and needs no environment variables in production.
# Optional: host port for docker compose (container always listens on 8080).
PORT=8080

# Development only (vite dev server): path to a local TF2 install used by the /__dev-tf2/ test endpoint
# when opening http://localhost:5174/?devtf2 . Never used in production builds.
# TF2_ROOT=D:/SteamLibrary/steamapps/common/Team Fortress 2

# Catalog build only: TF2 "tf" folder used for English item names (resource/tf_english.txt).
# TF2_DIR=D:/SteamLibrary/steamapps/common/Team Fortress 2/tf
